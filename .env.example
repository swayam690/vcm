# Folder containing your already downloaded video files (searched recursively).
VIDEO_DIR=/path/to/your/videos

# Create a Gemini API key in Google AI Studio and put it here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Full fine-tuned SigLIP2 weights (.safetensors) or a Hugging Face checkpoint directory.
SIGLIP_MODEL=google/siglip2-base-patch16-224
# Architecture and processor used when SIGLIP_MODEL points to a standalone weights file.
SIGLIP_BASE_MODEL=google/siglip2-base-patch16-224

FRAME_BATCH_SIZE=16
CACHE_VIDEO_COUNT=2
